# PARLOR: local secrets and config. NEVER commit this file (it is in .gitignore).
# Fill in the values marked REQUIRED. Agents read these as environment variables
# (run: set -a; source /Users/mac/local/internal/meta/XR/repo/.env; set +a).

# --- Meta Developer Dashboard (REQUIRED before the first upload) ---
# Dashboard: your app > Development > API
META_APP_ID=
META_APP_SECRET=
# Optional alternative to the secret: Account settings > "Get Oculus platform utility token"
META_PLATFORM_TOKEN=
# Optional: organization id (dashboard URL), used by `metavr store dist apps --org`
META_ORG_ID=
# Release channel created in the dashboard (Distribution > Release Channels)
META_RELEASE_CHANNEL=Competition

# --- Android package / release signing ---
# Leave the passwords empty and the agent generates strong ones, writes them here, and tells you.
ANDROID_PACKAGE_NAME=com.parlor.magicshow
KEYSTORE_PATH=/Users/mac/local/internal/meta/XR/repo/keystore/parlor.keystore
KEYSTORE_PASSWORD=
KEY_ALIAS=parlor
KEY_PASSWORD=

# --- Tooling (already installed, here for reference) ---
UNITY_EDITOR_VERSION=6000.6.9f1
UNITY_CLI=/Users/mac/.unity/bin/unity
METAVR_CLI=/Users/mac/.metavr/bin/metavr

# --- Submission info (fill whenever you can) ---
TARGET_LAUNCH_DATE="Q1 2027"
TEAM_MEMBER_NAME=
TEAM_MEMBER_ROLE=Developer

# The whole show performed with simulated hands and head. No autopilot.
seat 0 32
sleep 1
eval Parlor.NightStore.ResetAll(); Parlor.ParlorApp.Instance.Replace(); return "replaced";
until 20 placed: tier
hand right open @rest
until 40 gate arrival.hands →
until 40 beat GazeCardPick
sleep 3.5
look @card2 0.6
openxr_capture_composited_image {"eye":"left"} --out /Users/mac/local/internal/meta/XR/repo/Captures/onehand_01_gaze.jpg
until 30 chosen card
look @palm 0.6
until 40 gate coin.pick open
sleep 0.5
openxr_capture_composited_image {"eye":"left"} --out /Users/mac/local/internal/meta/XR/repo/Captures/onehand_02_coin.jpg
hand right pinch @coin
sleep 0.4
until 20 gate coin.place open
sleep 1.0
hand right open
hand right open @rest
until 40 gate coin.place →
sleep 6.5
openxr_capture_composited_image {"eye":"left"} --out /Users/mac/local/internal/meta/XR/repo/Captures/onehand_03_drop.jpg
sleep 1.2
openxr_capture_composited_image {"eye":"left"} --out /Users/mac/local/internal/meta/XR/repo/Captures/onehand_04_catch.jpg
sleep 2.5
eval return Parlor.DebugSeat.Stats();
openxr_capture_composited_image {"eye":"left"} --out /Users/mac/local/internal/meta/XR/repo/Captures/onehand_05_pit.jpg
until 60 gate palm.offer open
eval Parlor.ParlorApp.Instance.SetPaused(true); return "paused one-handed=" + Parlor.ParlorApp.Instance.Director.OneHanded;
sleep 2
eval Parlor.ParlorApp.Instance.SetPaused(false); return "resumed";
sleep 4
eval Parlor.ParlorApp.Instance.SetPaused(true); return "paused";
sleep 1
eval Parlor.ParlorApp.Instance.SetPaused(false); return "resumed";
sleep 4
eval Parlor.ParlorApp.Instance.SetPaused(true); return "paused";
sleep 1
eval Parlor.ParlorApp.Instance.SetPaused(false); return "resumed";
sleep 5
hand right open @palm {"wrist_orientation":[0,0,1,0]}
until 20 gate palm.offer →
sleep 2
openxr_capture_composited_image {"eye":"left"} --out /Users/mac/local/internal/meta/XR/repo/Captures/onehand_06_palm.jpg
until 60 gate lesson.palm open
until 30 gate lesson.close open
sleep 0.6
hand right fist
until 20 gate lesson.open open
sleep 0.5
openxr_capture_composited_image {"eye":"left"} --out /Users/mac/local/internal/meta/XR/repo/Captures/onehand_07_fist.jpg
hand right open
until 20 gate lesson.open →
sleep 1.5
openxr_capture_composited_image {"eye":"left"} --out /Users/mac/local/internal/meta/XR/repo/Captures/onehand_08_vanished.jpg
hand right open @rest
until 60 gate finale.cover open
sleep 1.0
hand right open @caseWrist {"wrist_orientation":[0,0,0,1]}
until 20 gate finale.cover →
until 20 gate finale.lift open
sleep 0.8
hand right open @rest
until 20 gate finale.lift →
until 80 beat CurtainCall
seat 0 8
sleep 1.5
openxr_capture_composited_image {"eye":"left"} --out /Users/mac/local/internal/meta/XR/repo/Captures/onehand_09_card.jpg
until 60 gate curtain.bow open
sleep 0.8
eval return Parlor.DebugSeat.Stats() + " onWall=" + Parlor.ParlorApp.Instance.Director.Curtains.OnWall;
openxr_capture_composited_image {"eye":"left"} --out /Users/mac/local/internal/meta/XR/repo/Captures/onehand_10_curtain.jpg
seat 0 34
until 30 gate curtain.bow →
seat 0 8
sleep 1
seat 0 32
until 60 gate encore.poke open
sleep 1
openxr_capture_composited_image {"eye":"left"} --out /Users/mac/local/internal/meta/XR/repo/Captures/onehand_11_encore.jpg
hand right poke @beforeToken
hand right poke @token
until 20 gate encore.poke →
handstate
